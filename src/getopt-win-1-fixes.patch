index 0000000..83175a2
--- /dev/null
+++ b/src/getopt_win.h
@@ -0,0 +1,173 @@
+/* Getopt for Microsoft C
+   This code is a modification of the Free Software Foundation, Inc.
+   Getopt library for parsing command line argument the purpose was
+   to provide a Microsoft Visual C friendly derivative. This code
+   provides functionality for both Unicode and Multibyte builds.
+
+   Date: 02/03/2011 - Ludvik Jerabek - Initial Release
+   Version: 1.1
+   Comment: Supports getopt, getopt_long, and getopt_long_only
+   and POSIXLY_CORRECT environment flag
+   License: LGPL
+
+   Revisions:
+   02/03/2011 - Ludvik Jerabek - Initial Release
+   02/20/2011 - Ludvik Jerabek - Fixed compiler warnings at Level 4
+   07/05/2011 - Ludvik Jerabek - Added no_argument, required_argument, optional_argument defs
+   08/03/2011 - Ludvik Jerabek - Fixed non-argument runtime bug which caused runtime exception
+   08/09/2011 - Ludvik Jerabek - Added code to export functions for DLL and LIB
+   02/15/2012 - Ludvik Jerabek - Fixed _GETOPT_WIN_THROW definition missing in implementation file
+   08/01/2012 - Ludvik Jerabek - Created separate functions for char and wchar_t characters so single dll can do both unicode and ansi
+   10/15/2012 - Ludvik Jerabek - Modified to match latest GNU features
+   06/19/2015 - Ludvik Jerabek - Fixed maximum option limitation caused by getopt_win_option_a (255) and getopt_win_option_w (65535) structure val variable
+   09/24/2022 - Ludvik Jerabek - Updated to match most recent getopt release
+   09/25/2022 - Ludvik Jerabek - Fixed memory allocation (malloc call) issue for wchar_t*
+   08/24/2025 - Ludvik Jerabek - Added reentrant function declarations, updated argv types to char ** and wchar_t **, added cross-compilation support
+   08/24/2025 - Ludvik Jerabek - Updated to match glibc 2.42 getopt
+
+
+   **DISCLAIMER**
+   THIS MATERIAL IS PROVIDED "AS IS" WITHOUT WARRANTY OF ANY KIND,
+   EITHER EXPRESS OR IMPLIED, INCLUDING, BUT Not LIMITED TO, THE
+   IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR
+   PURPOSE, OR NON-INFRINGEMENT. SOME JURISDICTIONS DO NOT ALLOW THE
+   EXCLUSION OF IMPLIED WARRANTIES, SO THE ABOVE EXCLUSION MAY NOT
+   APPLY TO YOU. IN NO EVENT WILL I BE LIABLE TO ANY PARTY FOR ANY
+   DIRECT, INDIRECT, SPECIAL OR OTHER CONSEQUENTIAL DAMAGES FOR ANY
+   USE OF THIS MATERIAL INCLUDING, WITHOUT LIMITATION, ANY LOST
+   PROFITS, BUSINESS INTERRUPTION, LOSS OF PROGRAMS OR OTHER DATA ON
+   YOUR INFORMATION HANDLING SYSTEM OR OTHERWISE, EVEN If WE ARE
+   EXPRESSLY ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
+*/
+#ifndef __GETOPT_WIN_H_
+#define __GETOPT_WIN_H_
+
+#ifdef _GETOPT_WIN_API
+#undef _GETOPT_WIN_API
+#endif
+
+#if defined(EXPORTS_GETOPT_WIN) && defined(STATIC_GETOPT_WIN)
+#error "The preprocessor definitions of EXPORTS_GETOPT_WIN and STATIC_GETOPT_WIN can only be used individually"
+#elif defined(STATIC_GETOPT_WIN)
+#pragma message("Warning static builds of getopt violate the Lesser GNU Public License")
+#define _GETOPT_WIN_API
+#elif defined(EXPORTS_GETOPT_WIN)
+#pragma message("Exporting getopt library")
+#define _GETOPT_WIN_API __declspec(dllexport)
+#else
+#pragma message("Importing getopt library")
+#define _GETOPT_WIN_API __declspec(dllimport)
+#endif
+
+// Change behavior for C\C++
+#ifdef __cplusplus
+#define _BEGIN_EXTERN_C extern "C" {
+#define _END_EXTERN_C }
+#define _GETOPT_WIN_THROW throw()
+#else
+#define _BEGIN_EXTERN_C
+#define _END_EXTERN_C
+#define _GETOPT_WIN_THROW
+#endif
+
+// Standard GNU options
+#define null_argument 0
+#define no_argument 0
+#define required_argument 1
+#define optional_argument 2
+
+// Shorter Options
+#define ARG_NULL 0
+#define ARG_NONE 0
+#define ARG_REQ 1
+#define ARG_OPT 2
+
+#include <string.h>
+#include <wchar.h>
+
+_BEGIN_EXTERN_C
+
+// Forward declarations for reentrant structures
+struct _getopt_win_data_a;
+struct _getopt_win_data_w;
+
+extern _GETOPT_WIN_API int getopt_win_optind;
+extern _GETOPT_WIN_API int getopt_win_opterr;
+extern _GETOPT_WIN_API int getopt_win_optopt;
+
+// ANSI
+struct getopt_win_option_a
+{
+    const char* name;
+    int has_arg;
+    int* flag;
+    int val;
+};
+
+extern _GETOPT_WIN_API char* getopt_win_optarg_a;
+
+extern _GETOPT_WIN_API int getopt_win_a(int argc, char* const * argv, const char* optstring) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int __posix_getopt_win_a(int argc, char* const * argv, const char* optstring) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int getopt_win_long_a(int argc, char* const * argv, const char* options,
+                                     const struct getopt_win_option_a* long_options, int* opt_index) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int getopt_win_long_only_a(int argc, char* const * argv, const char* options,
+                                          const struct getopt_win_option_a* long_options, int* opt_index) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int _getopt_win_long_r_a(int argc, char* const * argv, const char* options,
+                                        const struct getopt_win_option_a* long_options, int* opt_index,
+                                        struct _getopt_win_data_a* d) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int _getopt_win_long_only_r_a(int argc, char* const * argv, const char* options,
+                                             const struct getopt_win_option_a* long_options, int* opt_index,
+                                             struct _getopt_win_data_a* d) _GETOPT_WIN_THROW;
+
+// Unicode
+struct getopt_win_option_w
+{
+    const wchar_t* name;
+    int has_arg;
+    int* flag;
+    int val;
+};
+
+extern _GETOPT_WIN_API wchar_t* getopt_win_optarg_w;
+extern _GETOPT_WIN_API int getopt_win_w(int argc, wchar_t* const * argv, const wchar_t* optstring) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int __posix_getopt_win_w(int argc, wchar_t* const * argv, const wchar_t* optstring) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int getopt_win_long_w(int argc, wchar_t* const * argv, const wchar_t* options,
+                                     const struct getopt_win_option_w* long_options, int* opt_index) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int getopt_win_long_only_w(int argc, wchar_t* const * argv, const wchar_t* options,
+                                          const struct getopt_win_option_w* long_options, int* opt_index) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int _getopt_win_long_r_w(int argc, wchar_t* const * argv, const wchar_t* options,
+                                        const struct getopt_win_option_w* long_options, int* opt_index,
+                                        struct _getopt_win_data_w* d) _GETOPT_WIN_THROW;
+extern _GETOPT_WIN_API int _getopt_win_long_only_r_w(int argc, wchar_t* const * argv, const wchar_t* options,
+                                             const struct getopt_win_option_w* long_options, int* opt_index,
+                                             struct _getopt_win_data_w* d) _GETOPT_WIN_THROW;
+_END_EXTERN_C
+
+#undef _BEGIN_EXTERN_C
+#undef _END_EXTERN_C
+#undef _GETOPT_WIN_THROW
+#undef _GETOPT_WIN_API
+
+// Map the standard getopt names to the getopt_win implementation.
+// Define GETOPT_WIN_NO_COMPAT_MACROS to only use the getopt_win_ prefixed names.
+#ifndef GETOPT_WIN_NO_COMPAT_MACROS
+#define optind getopt_win_optind
+#define opterr getopt_win_opterr
+#define optopt getopt_win_optopt
+#ifdef _UNICODE
+#define getopt getopt_win_w
+#define __posix_getopt __posix_getopt_win_w
+#define getopt_long getopt_win_long_w
+#define getopt_long_only getopt_win_long_only_w
+#define option getopt_win_option_w
+#define optarg getopt_win_optarg_w
+#else
+#define getopt getopt_win_a
+#define __posix_getopt __posix_getopt_win_a
+#define getopt_long getopt_win_long_a
+#define getopt_long_only getopt_win_long_only_a
+#define option getopt_win_option_a
+#define optarg getopt_win_optarg_a
+#endif
+#endif  // GETOPT_WIN_NO_COMPAT_MACROS
+#endif  // __GETOPT_WIN_H_
